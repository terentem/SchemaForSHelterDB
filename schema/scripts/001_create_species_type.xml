<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="terentem">
        <createTable tableName="species_types">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_species_types"/>
            </column>

            <column name="species_name" type="varchar(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_species_name"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>

