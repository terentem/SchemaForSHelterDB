<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="5" author="terentem">
        <createTable tableName="animals">

            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_animals"/>
            </column>

            <column name="clinic_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>

            <column name="species_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="birthday" type="date">
                <constraints nullable="false"/>
            </column>

            <column name="chip_code" type="bigint"/>

        </createTable>

        <addForeignKeyConstraint baseTableName="animals"
                                 baseColumnNames="clinic_id"
                                 constraintName="fk_clinics_id"
                                 referencedTableName="clinics"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>

        <addForeignKeyConstraint baseTableName="animals"
                                 baseColumnNames="species_id"
                                 constraintName="fk_species_id"
                                 referencedTableName="species_types"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"/>
    </changeSet>

</databaseChangeLog>