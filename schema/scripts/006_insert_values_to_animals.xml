<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="4" author="terentem">
        <loadData tableName="animals" file="../data/animals.csv" relativeToChangelogFile="true">
            <column name="name" type="STRING"/>
            <column name="birthday" type="DATE"/>
            <column name="species_id" type="NUMERIC"/>
            <column name="clinic_id" type="NUMERIC"/>
            <column name="chip_code" type="NUMERIC"/>
        </loadData>
    </changeSet>
</databaseChangeLog>